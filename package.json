{
  "name": "smolup",
  "version": "0.4.1",
  "description": "Download, trim and manage Smolish videos from the command line.",
  "type": "module",
  "bin": {
    "smolup": "bin/smolup.js",
    "smush": "bin/smolup.js",
    "smup": "bin/smolup.js",
    "smop": "bin/smolup.js"
  },
  "license": "MIT",
  "author": "Mailo037",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mailo037/smolup.git"
  },
  "homepage": "https://github.com/Mailo037/smolup#readme",
  "bugs": {
    "url": "https://github.com/Mailo037/smolup/issues"
  },
  "keywords": [
    "smolish",
    "cli",
    "video",
    "uploader",
    "veo",
    "watchdog"
  ],
  "publishConfig": {
